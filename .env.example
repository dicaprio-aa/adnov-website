# ==============================================================================
# ADNOV Creative Agency - Environment Variables Configuration
# ==============================================================================

# 1. Supabase Frontend Configuration (Required for Live Database Sync)
# Found in: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Note: The website operates gracefully in "Demo Mode" if these keys are left as placeholders,
# storing enquiries safely in browser localStorage for testing without errors.

# ==============================================================================
# 2. Supabase Edge Functions Secrets (Set in Supabase Dashboard -> Project Settings -> Edge Functions -> Secrets)
# ==============================================================================
# RESEND_API_KEY=re_your_resend_api_key_here
# OFFICIAL_NOTIFICATION_EMAIL=hello@adnovcreative.com
# FROM_EMAIL=ADNOV Agency <notifications@your-verified-domain.com>
